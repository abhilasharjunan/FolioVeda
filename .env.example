# Required
DATABASE_URL="postgresql://user:password@host:5432/db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Optional (Redis caching)
REDIS_URL=""

# Optional — FinAPI Pro key (finapi.upvaly.com) for fresh fund holdings used by
# the portfolio overlap / look-through analysis. Without it, overlap falls back
# to whatever disclosed holdings are already cached in SectorCache.
FINAPI_API_KEY=""

# Required for cron jobs (Vercel) — set a random secret
CRON_SECRET=""

# Admin allowlist — comma-separated emails promoted to ADMIN on signup/login
ADMIN_EMAILS=""

# Optional — deep-link for Admin “Traffic” card (defaults to vercel.com/dashboard)
NEXT_PUBLIC_VERCEL_ANALYTICS_URL=""

# Email (SMTP) — required for forgot password
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@folioveda.app"
